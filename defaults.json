{
  "version": "0.3.0-rc1",
  "platform": "PC",
  "initial_trial_mode": "workflow_test",
  "assembly_mode": "provider_first",
  "unity_server": "unityMCP",
  "unity_backend": "UnityMCP-VRC",
  "write_concurrency": 1,
  "start_contract": {
    "required_before_unity_write": true,
    "question_count": 5,
    "single_message": true,
    "allow_all_recommended_reply": true,
    "visualization_question_first": true,
    "default_visualization": "selection_map_then_updatable_batch_gallery_with_full_and_close_before_after_views",
    "default_size_metric": "sdk_uncompressed_bytes",
    "default_hard_limit_bytes": 300000000,
    "default_working_limit_ratio": 0.9,
    "size_gate_completion_and_upload_must_be_explicit_booleans": true,
    "sdk_size_applies_to_all_target_platforms": true,
    "sdk_size_actual_bytes_are_per_platform": true,
    "sdk_size_receipt_must_close_to_final_build_report_and_job": true,
    "size_receipt_mismatch_failure": "SIZE_RECEIPT_MISMATCH",
    "default_batch_cadence": "preflight_all_install_all_smoke_only_then_unified_acceptance",
    "batch_cadence_is_fixed_default_not_a_start_question": true,
    "question_slots": [
      "visualization",
      "size_budget",
      "content_priority_performance_and_exceptions",
      "menu_plan",
      "delivery_layers_and_upload_authority"
    ],
    "content_priority_required_fields": [
      "required_resource_ids",
      "optional_resource_ids",
      "optional_failure_action",
      "extra_over_budget_action",
      "requested_affected_chest_states",
      "affected_chest_states"
    ],
    "default_requested_affected_chest_states": [
      "small",
      "default",
      "large"
    ],
    "non_default_requested_affected_chest_states_require_explicit_user_override_source": true,
    "affected_chest_states_must_match_requested": true,
    "performance_contract_is_question_3_not_question_6": true,
    "target_platform_is_discovered_in_assembly_manifest": true,
    "allowed_delivery_layers": [
      "local_prefab",
      "exported_package",
      "sdk_build",
      "client_runtime",
      "private_upload"
    ],
    "require_explicit_upload_authority_record": true,
    "assembly_manifest_is_discovery_prefilled": true,
    "assembly_manifest_sdk_context_is_authoritative_read_only_discovery": true,
    "style_color_default_version_are_preferences_not_a_routine_question": true
  },
  "performance_contract": {
    "default_policy_mode": "measured_best_effort",
    "allowed_policy_modes": [
      "measured_best_effort",
      "rank_gate",
      "metric_caps"
    ],
    "platforms": [
      "PC",
      "Android"
    ],
    "default_target_rank": "Good",
    "allowed_target_ranks": [
      "Excellent",
      "Good",
      "Medium"
    ],
    "medium_is_acceptable": true,
    "poor_and_verypoor_require_frozen_policy": true,
    "every_platform_requires_target_rank_or_metric_caps": true,
    "best_effort_poor_and_verypoor_never_target_met": true,
    "all_policy_modes_poor_and_verypoor_never_target_met": true,
    "metric_caps_report_caps_met_separately_from_target_met": true,
    "same_source_candidate_can_be_reused_across_platforms": true,
    "per_platform_job_build_report_and_evidence_are_independent": true,
    "performance_and_build_evidence_require_platform_binding": true,
    "cross_platform_report_source_reuse_fails_closed": true,
    "different_platform_override_requires_bound_semantic_acceptance": true,
    "formal_baseline_required_before_installation": true,
    "baseline_requires_preflight_timestamp_and_canonical_hashed_receipt": true,
    "baseline_and_final_report_sources_must_be_disjoint": true,
    "final_measurement_time_must_be_after_baseline": true,
    "all_sdk_evidence_must_match_assembly_manifest_current_vrcsdk_version": true,
    "sdk_version_change_invalidates_baseline_final_jobs_and_size_receipts": true,
    "baseline_failure": "PERFORMANCE_BASELINE_UNVERIFIED",
    "default_rank_handling": {
      "Poor": "block",
      "VeryPoor": "block"
    },
    "gate_completion": true,
    "gate_upload": true,
    "rank_is_static_analysis_not_fps": true,
    "inactive_objects_and_components_count": true,
    "build_and_test_is_not_formal_rank_or_size_evidence": true,
    "allowed_actions": [
      "selected_variants_only",
      "generated_copy_texture_limits",
      "remove_proven_unreferenced_generated_assets",
      "semantic_safe_dedupe",
      "aao_proven_unused_only"
    ],
    "protected_features": [
      "outfit_part_controls",
      "blendshapes_and_chest_states",
      "material_animations",
      "provider_writers",
      "physbones",
      "contacts",
      "particles",
      "audio"
    ],
    "headroom_policy": {
      "gate_completion": true,
      "gate_upload": true,
      "PC": {
        "expression_parameter_bits": {
          "limit": 256,
          "reserve": 16
        },
        "physbone_components": {
          "limit": 256,
          "reserve": 16
        }
      },
      "Android": {
        "expression_parameter_bits": {
          "limit": 256,
          "reserve": 16
        },
        "physbone_components": {
          "limit": 8,
          "reserve": 1
        }
      }
    },
    "headroom_limit_is_official_and_not_user_overridable": true,
    "only_headroom_reserve_is_task_configurable": true,
    "official_sdk_hard_metric_limits": {
      "expression_parameter_bits": 256,
      "physbone_components": 256,
      "physbone_colliders": 256,
      "contacts": 256,
      "raycasts": 80
    },
    "official_platform_bundle_limits_bytes": {
      "PC": {
        "download": 200000000,
        "uncompressed": 500000000
      },
      "Android": {
        "download": 10000000,
        "uncompressed": 40000000
      }
    },
    "android_hard_component_limits": {
      "physbone_components": 8,
      "physbone_transforms": 64,
      "physbone_colliders": 16,
      "physbone_collision_checks": 64,
      "contacts": 16,
      "constraints": 150,
      "constraint_depth": 50
    },
    "current_installed_vrcsdk_report_is_authoritative": true,
    "formal_measurement_job": {
      "job_id_inputs": [
        "platform",
        "candidate",
        "candidate_revision",
        "candidate_sha256",
        "sdk_version"
      ],
      "terminal_status": "SUCCEEDED",
      "dispatch_count": 1,
      "timeout_action": "poll_same_job",
      "result_evidence_fields": [
        "kind",
        "platform",
        "candidate",
        "candidate_revision",
        "candidate_sha256",
        "sdk_version",
        "layer",
        "source"
      ],
      "result_evidence_must_close_to_final_performance_and_build_sources": true,
      "missing_mismatch_redispatch_or_nonterminal": "PERFORMANCE_UNVERIFIED"
    },
    "final_measurement_requires_exact_platform_candidate_sdk_rank_worst_and_full_snapshot": true,
    "all_nonzero_baseline_to_final_deltas_require_attribution": true,
    "delta_resource_sources_must_be_selected_and_installed": true,
    "delta_action_sources_must_be_allowed_and_applied": true,
    "phantom_or_unknown_delta_entries_are_rejected": true,
    "platform_size_download_and_uncompressed_deltas_require_attribution": true,
    "rejected_required_resource_cannot_enter_installation": true,
    "rejected_optional_resource_requires_isolation_and_install_set_exclusion": true,
    "unattributed_delta_failure": "PERFORMANCE_DELTA_UNATTRIBUTED",
    "platform_size_failure": "PLATFORM_SIZE_LIMIT_EXCEEDED",
    "headroom_failure": "PERF_HEADROOM_EXHAUSTED"
  },
  "base_optimization": {
    "auto_apply": true,
